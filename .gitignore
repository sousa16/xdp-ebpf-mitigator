coverage.txt
coverage.html
*.prof
vendor/

# ── Project docs ──────────────────────────────────────────────────────────
# Roadmap source and export are kept local, not published with the repo.
xdp-ebpf-mitigator-roadmap.pdf
xdp-ebpf-mitigator-roadmap.docx

# Obsidian vault config for docs/ — local editor state, not project content.
docs/.obsidian/

